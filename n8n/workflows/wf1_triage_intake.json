      "id": "358d0568-e06d-5700-ac42-c3219e3ff9ea",
      "name": "Email Trigger (IMAP) [read-only, disabled]",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [
        0,
