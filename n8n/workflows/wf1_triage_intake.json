    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst h = j.headers || {};\nconst b = j.body || {};\nconst expected = $env.N8N_INGEST_TOKEN || '';\nconst authorized = expected.length > 0 && (h['x-ingest-token'] || '') === expected;\nreturn [{ json: {\n  authorized,\n  run_tag: (b.run_tag || '').toString(),\n  email: {\n    message_id: (b.message_id || ('webhook-' + Date.now())).toString(),\n    source: b.source || 'webhook',\n    from_email: (b.from_email || '').toString(),\n    from_name: (b.from_name || '').toString(),\n    subject: (b.subject || '').toString().slice(0, 500),\n    body_text: (b.body_text || '').toString().slice(0, 8000),\n    received_at: b.received_at || new Date().toISOString(),\n  }\n}}];"
      },
      "id": "7445372e-9531-5d2a-b6b3-24be514f20dd",
      "name": "Normalize: webhook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Read-only IMAP trigger output -> InboundEmail shape. Never replies, never deletes.\nconst j = $input.first().json;\nconst fromObj = j.from && j.from.value && j.from.value[0] ? j.from.value[0] : {};\nconst addr = fromObj.address || (typeof j.from === 'string' ? (j.from.match(/[\\w.+-]+@[\\w.-]+\\.[A-Za-z]{2,}/) || [''])[0] : '');\nconst name = fromObj.name || '';\nconst body = (j.textPlain || j.text || j.textHtml || '').toString();\nreturn [{ json: {\n  authorized: true,\n  run_tag: 'imap',\n  email: {\n    message_id: (j.messageId || (j.metadata && j.metadata['message-id']) || ('imap-' + Date.now())).toString(),\n    source: 'imap',\n    from_email: addr,\n    from_name: name,\n    subject: (j.subject || '').toString().slice(0, 500),\n    body_text: body.slice(0, 8000),\n    received_at: j.date ? new Date(j.date).toISOString() : new Date().toISOString(),\n  }\n}}];"
      },
      "id": "6256ad09-bbfa-5dbc-ab66-e370dd00c97e",
      "name": "Normalize: IMAP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
