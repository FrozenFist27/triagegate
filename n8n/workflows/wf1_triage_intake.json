      },
      "id": "411cfcae-b4ae-50be-8210-c8e73b8c1234",
      "name": "HTTP: Save Slack Ref",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        -40
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const t = $('HTTP: Triage').first().json;\nlet slackPosted = null;\ntry { slackPosted = !!$('Slack: Post Approval').first().json.ok; } catch (e) {}\nreturn [{ json: {\n  run_id: t.run_id, status: t.status, route: t.route, attempts: t.attempts,\n  triage: t.triage || null, approval_id: t.approval_id || null, slack_posted: slackPosted,\n}}];"
      },
      "id": "2d1c4a23-3bda-529e-96b2-4d00d4d3888c",
