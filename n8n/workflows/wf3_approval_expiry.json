{
  "name": "TriageGate - WF3 Approval Expiry",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "2f07a7c0-516e-533b-8556-0d3a4c59f746",
      "name": "Schedule: every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://triage-api:8000/approvals/expire",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.TRIAGE_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ '{}' }}"
      },
      "id": "b77b15c1-15b2-5db8-bcce-bf604a69ac2e",
      "name": "HTTP: Expire overdue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "expired",
        "options": {}
      },
      "id": "995fe622-5cde-5292-9189-b8caa0c2a8de",
      "name": "Split Out: expired",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "a895f286-e27e-5e73-96c2-015f97cb3c64",
              "leftValue": "={{ $json.slack_ts }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "dd456878-33a6-52da-a59d-74025896c1b2",
      "name": "IF: has Slack ref?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.update",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SLACK_BOT_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $json.slack_channel, ts: $json.slack_ts, text: $json.slack_text, blocks: $json.slack_blocks }) }}"
      },
      "id": "a1fd78c5-389b-5887-ac9c-4ab77bc0c7cd",
      "name": "Slack: Update (expired)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        -60
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Schedule: every minute": {
      "main": [
        [
          {
            "node": "HTTP: Expire overdue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP: Expire overdue": {
      "main": [
        [
          {
            "node": "Split Out: expired",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Out: expired": {
      "main": [
        [
          {
            "node": "IF: has Slack ref?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF: has Slack ref?": {
      "main": [
        [
          {
            "node": "Slack: Update (expired)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "instanceId": "sanitized"
  },
  "active": false,
  "tags": [],
  "versionId": "ba4d4f1e-9f2e-5fa4-b624-6300147dc5fb",
  "id": "0d541ab7225854",
  "description": "Every minute: expire overdue approvals (TTL 24h prod / 2 min demo) and update the Slack cards."
}
