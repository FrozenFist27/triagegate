# Copy to .env and fill in. NEVER commit .env.
# Generated placeholder file - names only, no real values.

# --- LLM (Anthropic) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=replace_me
LLM_MAX_ATTEMPTS=3
LLM_FAULT_INJECTION=off
# Haiku 5.5 pricing per 1M tokens (input / output) for cost accounting
LLM_PRICE_IN_PER_MTOK=0.10
LLM_PRICE_OUT_PER_MTOK=0.50

# --- Internal service auth (generate your own random strings) ---
TRIAGE_API_TOKEN=replace_me_random_string
N8N_INGEST_TOKEN=replace_me_random_string

# --- Approvals ---
APPROVAL_TTL_MINUTES=1440

# --- Storage ---
DB_PATH=data/triagegate.db

# --- n8n ---
N8N_PUBLIC_URL=https://replace-me.trycloudflare.com/
N8N_ENCRYPTION_KEY=replace_me_random_string

# --- Slack ---
SLACK_BOT_TOKEN=replace_me_bot_token_xoxb
SLACK_SIGNING_SECRET=replace_me
SLACK_APPROVAL_CHANNEL_ID=C00000000

# --- HubSpot (service key, sent as Bearer) ---
HUBSPOT_SERVICE_KEY=replace_me

# --- Test inbox (IMAP, live demo only; eval uses the webhook path) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=replace_me
IMAP_APP_PASSWORD=replace_me
